/* MainMenu.uss */

.screen {
    width: 100%;
    height: 100%;
    background-color: rgb(12, 13, 24);
    color: rgb(242, 237, 226);
    overflow: hidden;
}

.content {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding-top: 80px;
}

.eyebrow {
    color: rgb(201, 164, 92);
    font-size: 14px;
    -unity-text-align: middle-center;
    letter-spacing: 4px;
}

.title {
    margin-top: 12px;
    color: rgb(245, 221, 167);
    font-size: 92px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.subtitle {
    margin-top: 12px;
    color: rgb(183, 185, 201);
    font-size: 18px;
    -unity-text-align: middle-center;
}

.rule {
    width: 340px;
    height: 1px;
    margin-top: 34px;
    margin-bottom: 26px;
    background-color: rgb(96, 87, 111);
}

.menu {
    width: 320px;
    align-items: stretch;
}

.menu-button {
    min-height: 52px;
    margin-top: 8px;
    border-width: 1px;
    border-color: rgb(74, 74, 96);
    border-radius: 3px;
    background-color: rgba(27, 28, 47, 0.92);
    color: rgb(231, 229, 222);
    font-size: 17px;
    -unity-font-style: bold;
}

.menu-button:hover,
.menu-button:focus {
    border-color: rgb(201, 164, 92);
    background-color: rgb(48, 43, 68);
    color: rgb(255, 243, 204);
}

.menu-button:active {
    background-color: rgb(201, 164, 92);
    color: rgb(20, 18, 31);
}

.menu-button:disabled {
    color: rgb(104, 105, 120);
    background-color: rgba(22, 23, 38, 0.7);
    border-color: rgb(47, 48, 65);
}

.menu-button-primary {
    min-height: 60px;
    border-color: rgb(201, 164, 92);
    background-color: rgb(103, 72, 65);
    color: rgb(255, 243, 204);
    font-size: 20px;
}

.hint {
    margin-top: 44px;
    color: rgb(119, 121, 143);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.glow {
    position: absolute;
    width: 420px;
    height: 420px;
    border-radius: 210px;
    background-color: rgba(76, 54, 103, 0.16);
}

.glow-left {
    left: -180px;
    top: 180px;
}

.glow-right {
    right: -180px;
    bottom: -140px;
    background-color: rgba(139, 86, 67, 0.13);
}

.settings-panel {
    display: none;
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 9, 17, 0.86);
}

.settings-panel.is-open {
    display: flex;
}

.settings-card {
    width: 430px;
    padding: 42px 48px 38px;
    border-width: 1px;
    border-color: rgb(103, 89, 112);
    border-radius: 5px;
    background-color: rgb(25, 25, 43);
}

.panel-eyebrow {
    color: rgb(201, 164, 92);
    font-size: 14px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

.panel-title {
    margin-top: 8px;
    margin-bottom: 30px;
    color: rgb(245, 221, 167);
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.settings-card Toggle,
.settings-card Slider {
    margin-top: 18px;
    color: rgb(218, 217, 211);
    font-size: 16px;
}

.panel-note {
    margin-top: 24px;
    margin-bottom: 16px;
    color: rgb(145, 147, 164);
    font-size: 13px;
}