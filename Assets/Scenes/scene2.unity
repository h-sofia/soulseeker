  m_Script: {fileID: 11500000, guid: 6f3a0f7d0e3a4b1b9c20d5a1f0c8e7b6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue: "|- 18 july\nMom keeps forcing me to go to church with her. I try to
    keep to myself yet I feel his eyes following me. I wish he\u2019d leave me alone.\r\nI\u2019ll
    see Leo today. She keeps trying to convince me to hang out at this college party.
    Maybe I\u2019ll go if only to stop thinking about everything. She doesn\u2019t
    know anything, of course. No one does.\r\n\r\n"
  dialogueUI: {fileID: 0}
