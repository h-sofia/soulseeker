  m_Script: {fileID: 11500000, guid: 6f3a0f7d0e3a4b1b9c20d5a1f0c8e7b6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TornPageInteractable
  dialogue: "|- Another torn page. The writing continues, but some of the words are
    difficult to read.\n\n20 August\r\n\r\nI can\u2019t sleep. Eyes are on me. He\u2019s
    always there, judging. \r\nLeo and I had a fight the other day. I know she wants
    to leave. I guess I do too. Yet I know I shouldn\u2019t. There\u2019s something
    wrong with me. I can feel it. I can\u2026\r\n"
  dialogueUI: {fileID: 0}
