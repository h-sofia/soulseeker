  m_Script: {fileID: 11500000, guid: 6f3a0f7d0e3a4b1b9c20d5a1f0c8e7b6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TornPageInteractable
  dialogue: "|- 30 october\r\n\r\nIt\u2019s here. I don\u2019t know. I wake up with
    weird scratches on my arms. I don\u2019t remember anything from last week. The
    priest keeps pleading with my mom to let him talk to him. I don\u2019t want him
    near me. Not ever again. I feel like puking. Leo keeps asking what\u2019s wrong.
    I don\u2019t know what to tell her. \r\n"
  dialogueUI: {fileID: 0}
