<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="DialogueBox" style="width: 90%; height: 200px; position: absolute; bottom: 20px; left: 5%; padding: 20px; background-color: rgba(0, 0, 0, 0.85);">
        <ui:VisualElement name="Portrait" style="position: absolute; right: 20px; top: 20px; width: 140px; height: 140px;"/>
        <ui:Label name="SpeakerName" text="Personaje" style="color: white; font-size: 30px; width: 75%; -unity-font-style: bold;"/>
        <ui:Label name="DialogueText" text="Hola, este es mi primer diálogo." style="color: white; font-size: 25px; width: 75%; white-space: normal;"/>
    </ui:VisualElement>
    <ui:Label name="ContinueText" text="Click to continue..." style="position: absolute; bottom: 32px; right: 8%; color: white;"/>
</ui:UXML>
